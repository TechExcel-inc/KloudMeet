# Kloud Meet — billing (v1). Placeholders only; real values go in .env.local / the server env.
# Off by default: unset or false ⇒ everyone is LEGACY (unlimited) and no limit is enforced.
BILLING_ENABLED=false

# Stripe (use test-mode keys first: sk_test_… / whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin the Stripe API version sent with requests (e.g. 2025-03-31.basil)
STRIPE_API_VERSION=

# Stripe price IDs (price_…), created in the Stripe dashboard
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_HOURS_PACK=

# Public origin used for Stripe success / cancel / portal return URLs (falls back to the request origin)
NEXT_PUBLIC_APP_URL=

# ── Email (verification codes) ─────────────────────────────────────────────
# Recipients on Chinese mailboxes (QQ, 163, .cn, enterprise mail hosted in China — detected by MX)
# go through Alibaba Cloud DirectMail; everyone else through Postmark. A failed send falls back to
# the next configured provider. Brevo still works as a fallback while migrating.
MAIL_FROM_ADDRESS=noreply@kloudmeet.com
MAIL_FROM_NAME=Kloud Meet
# Optional overrides of the first provider per route: postmark | aliyun | brevo
MAIL_PROVIDER=
MAIL_PROVIDER_CN=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
# The sender address configured in the DirectMail console, e.g. noreply@mail.kloud.cn
ALIYUN_DM_ACCOUNT_NAME=
# https://dm.aliyuncs.com (Hangzhou, default) — use the endpoint of the region your sender domain is in
ALIYUN_DM_ENDPOINT=
BREVO_API_KEY=
