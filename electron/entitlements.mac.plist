<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the notarized macOS build. -->
<plist version="1.0">
<dict>
  <!-- Electron / V8 needs JIT and writable-executable memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Native modules (@nut-tree-fork libnut, node-mac-permissions) are not signed by our team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Meeting camera and microphone. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Remote control drives the mouse through Accessibility / Apple Events. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
