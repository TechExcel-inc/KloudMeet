generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AccountMembership {
  id           Int              @id @default(autoincrement())
  accountId    Int
  teamMemberId Int
  status       String           @default("ACTIVE")
  joinedVia    String?
  joinedAt     DateTime         @default(now())
  createdAt    DateTime         @default(now())
  createdBy    String?
  modifiedAt   DateTime?
  modifiedBy   String?
  deletedAt    DateTime?
  deletedBy    String?
  account      KloudMeetAccount @relation(fields: [accountId], references: [id], map: "AccountMembership_accountId_fkey")
  teamMember   TeamMember       @relation(fields: [teamMemberId], references: [id], map: "AccountMembership_teamMemberId_fkey")

  @@unique([accountId, teamMemberId], map: "AccountMembership_accountId_teamMemberId_key")
  @@index([teamMemberId], map: "AccountMembership_teamMemberId_fkey")
  @@map("AccountMembership")
}

model AccountOwnerAndAdmin {
  id                 Int              @id @default(autoincrement())
  accountId          Int
  teamMemberId       Int
  role               String
  assignedAt         DateTime         @default(now())
  assignedByMemberId Int?
  status             String           @default("ACTIVE")
  createdAt          DateTime         @default(now())
  createdBy          String?
  modifiedAt         DateTime?
  modifiedBy         String?
  account            KloudMeetAccount @relation(fields: [accountId], references: [id], map: "AccountOwnerAndAdmin_accountId_fkey")
  teamMember         TeamMember       @relation(fields: [teamMemberId], references: [id], map: "AccountOwnerAndAdmin_teamMemberId_fkey")

  @@unique([accountId, teamMemberId], map: "AccountOwnerAndAdmin_accountId_teamMemberId_key")
  @@index([teamMemberId], map: "AccountOwnerAndAdmin_teamMemberId_fkey")
  @@map("AccountOwnerAndAdmin")
}

model KloudMeetAccount {
  id                     Int                    @id @default(autoincrement())
  accountCode            String                 @unique(map: "KloudMeetAccount_accountCode_key")
  accountName            String
  organizationType       Int?
  teamSize               String?
  enableAutoJoinViaEmail Boolean                @default(false)
  emailDomains           String?
  joinTeamCode           String?                @unique(map: "KloudMeetAccount_joinTeamCode_key")
  contactEmail           String?
  contactPhone           String?
  description            String?
  /// Kloud company (kloud.cn SchoolID) this account mirrors; members flow one way, Kloud → Kloud Meet (prisma/add_account_linking.sql)
  kloudCompanyId         String?                @unique(map: "KloudMeetAccount_kloudCompanyId_key") @db.VarChar(32)
  kloudCompanyName       String?
  kloudLinkedAt          DateTime?
  kloudLinkedBy          Int?
  /// Company settings → Camera backgrounds: what members start with, and whether only company images may be used (prisma/add_company_backgrounds.sql)
  defaultBackgroundId    Int?
  backgroundsCompanyOnly Boolean                @default(false)
  status                 Int                    @default(1)
  createdAt              DateTime               @default(now())
  createdBy              String?
  modifiedAt             DateTime?
  modifiedBy             String?
  deletedAt              DateTime?
  deletedBy              String?
  memberships            AccountMembership[]
  ownersAndAdmins        AccountOwnerAndAdmin[]
  meetings               Meeting[]
  billingSubscription    BillingSubscription?
  billingSeats           BillingSeat[]
  billingCredits         BillingCredit[]
  backgrounds            AccountBackground[]

  @@map("KloudMeetAccount")
}

/// A camera background a company's owners and admins add for everyone in it: 1280×720 and 320×180 JPEGs.
model AccountBackground {
  id                Int              @id @default(autoincrement())
  accountId         Int
  name              String           @db.VarChar(80)
  image             Bytes            @db.MediumBlob
  thumb             Bytes            @db.MediumBlob
  /// Changes with the picture; part of its URL, so browsers may keep it forever
  version           String           @db.VarChar(16)
  createdAt         DateTime         @default(now())
  createdByMemberId Int?
  modifiedAt        DateTime?
  account           KloudMeetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, map: "AccountBackground_accountId_fkey")

  @@index([accountId], map: "AccountBackground_accountId_idx")
  @@map("AccountBackground")
}

model Meeting {
  id                      Int                      @id @default(autoincrement())
  roomName                String                   @unique(map: "Meeting_roomName_key")
  roomSid                 String?
  title                   String?
  accountId               Int?
  createdByMemberId       Int
  startedAt               DateTime                 @default(now())
  endedAt                 DateTime?
  scheduledFor            DateTime?
  timezone                String?
  durationMinutes         Int?
  actualStartedAt         DateTime?
  actualDurationMinutes   Int?
  description             String?
  maxParticipants         Int                      @default(0)
  status                  String                   @default("ACTIVE")
  createdAt               DateTime                 @default(now())
  createdBy               String?
  modifiedAt              DateTime?
  modifiedBy              String?
  deletedAt               DateTime?
  kloudMeetingId          Int?
  endedReason             String?
  rejoinableUntil         DateTime?
  roomEmptyAt             DateTime?
  /// Recording settings for this meeting (set by the host in the recording sheet)
  recordingHostOnly       Boolean                  @default(true)
  recordingMode           String                   @default("follow")
  recordingSyncTranscript Boolean                  @default(true)
  /// Pre-join Recording choice: none | ai_smart | livedoc_full | screen_share. Only livedoc_full
  /// changes how the record API works today; the others use the screen share recording.
  recordingOption         String                   @default("screen_share")
  /// Who is host / co-host / presenter right now, as reported by the current host's client:
  /// { host, cohosts[], presenters[] } (LiveKit identities). Used to check recording permission.
  meetingRoles            Json?
  /// Schedule dialog → Emails: send invitations / reminders to the attendees
  inviteEmails            Boolean                  @default(true)
  reminderEmails          Boolean                  @default(true)
  /// Minutes before the start to send reminders, e.g. [1440, 480]; null = the default
  reminderOffsets         Json?
  /// Who may join and watch the recordings: PUBLIC | PROTECTED | PRIVATE (prisma/add_meeting_access_levels.sql).
  /// NULL = a meeting from before access levels: anyone with the link joins, recordings keep the old rule.
  accessLevel             String?                  @default("PUBLIC") @db.VarChar(16)
  invitees                MeetingInvitee[]
  joinRequests            MeetingJoinRequest[]
  reminderLogs            MeetingReminderLog[]
  account                 KloudMeetAccount?        @relation(fields: [accountId], references: [id], map: "Meeting_accountId_fkey")
  createdByMember         TeamMember               @relation(fields: [createdByMemberId], references: [id], map: "Meeting_createdByMemberId_fkey")
  participants            MeetingParticipant[]
  chatMessages            MeetingChatMessage[]
  summaryItems            MeetingSummaryItem[]
  summary                 MeetingSummary?
  transcripts             MeetingTranscript[]
  recordings              Recording[]
  recordingAccessRequests RecordingAccessRequest[]

  @@index([accountId], map: "Meeting_accountId_fkey")
  @@index([createdByMemberId], map: "Meeting_createdByMemberId_fkey")
  @@map("Meeting")
}

model MeetingChatMessage {
  id              Int      @id @default(autoincrement())
  meetingId       Int
  clientMessageId String
  senderIdentity  String
  senderName      String
  content         String   @db.Text
  sentAt          DateTime
  createdAt       DateTime @default(now())
  meeting         Meeting  @relation(fields: [meetingId], references: [id], map: "MeetingChatMessage_meetingId_fkey")

  @@unique([meetingId, clientMessageId], map: "MeetingChatMessage_meetingId_clientMessageId_key")
  @@index([meetingId, sentAt, id], map: "MeetingChatMessage_meetingId_sentAt_id_idx")
  @@map("MeetingChatMessage")
}

model MeetingActivity {
  id                Int                   @id @default(autoincrement())
  meetingId         Int
  participantId     Int
  activityType      String
  startedAt         DateTime
  endedAt           DateTime?
  durationSeconds   Int?
  metadata          String?
  createdAt         DateTime              @default(now())
  participant       MeetingParticipant    @relation(fields: [participantId], references: [id], map: "MeetingActivity_participantId_fkey")
  liveDocActivities MeetLiveDocActivity[]

  @@index([participantId], map: "MeetingActivity_participantId_fkey")
  @@map("MeetingActivity")
}

model MeetingParticipant {
  id                Int                   @id @default(autoincrement())
  meetingId         Int
  teamMemberId      Int?
  meetUserId        Int?
  displayName       String
  roles             String                @default("PARTICIPANT")
  joinedAt          DateTime              @default(now())
  leftAt            DateTime?
  durationSeconds   Int?
  activities        MeetingActivity[]
  meetUser          MeetUser?             @relation(fields: [meetUserId], references: [id], map: "MeetingParticipant_meetUserId_fkey")
  meeting           Meeting               @relation(fields: [meetingId], references: [id], map: "MeetingParticipant_meetingId_fkey")
  teamMember        TeamMember?           @relation(fields: [teamMemberId], references: [id], map: "MeetingParticipant_teamMemberId_fkey")
  liveDocActivities MeetLiveDocActivity[]

  @@index([meetUserId], map: "MeetingParticipant_meetUserId_fkey")
  @@index([meetingId], map: "MeetingParticipant_meetingId_fkey")
  @@index([teamMemberId], map: "MeetingParticipant_teamMemberId_fkey")
  @@map("MeetingParticipant")
}

model MeetingSummaryItem {
  id         Int      @id @default(autoincrement())
  meetingId  Int
  title      String
  content    String   @db.Text
  timeOffset String
  /// 章节主讲人显示名；AI 生成时写入，回放卡片头像用其缩写
  speaker    String?
  /// Key points of this section: [{ text, sec }] — sec is where it was said; null for older summaries
  points     Json?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  meeting    Meeting  @relation(fields: [meetingId], references: [id], map: "MeetingSummaryItem_meetingId_fkey")

  @@index([meetingId, sortOrder], map: "MeetingSummaryItem_meetingId_sortOrder_idx")
  @@map("MeetingSummaryItem")
}

/// AI summary of a meeting: one-line topic, overview, who spoke, and to-dos
/// (sections and their points live in MeetingSummaryItem)
model MeetingSummary {
  id             Int      @id @default(autoincrement())
  meetingId      Int      @unique(map: "MeetingSummary_meetingId_key")
  topic          String?  @db.VarChar(500)
  overview       String?  @db.Text
  /// Names of people who spoke, most talk first
  speakers       Json?
  /// [{ task, owner, due, sec }] — owner / due are null when nobody said
  todos          Json?
  /// Model that wrote it (e.g. deepseek-chat), and why DeepSeek was skipped when another one did:
  /// "timeout", "HTTP 503", "error", "no-key". Shown only to internal staff.
  model          String?  @db.VarChar(100)
  fallbackReason String?  @db.VarChar(200)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade, map: "MeetingSummary_meetingId_fkey")

  @@map("MeetingSummary")
}

model MeetingTranscript {
  id              Int      @id @default(autoincrement())
  meetingId       Int
  speakerName     String
  speakerMemberId Int?
  content         String   @db.Text
  captionTime     DateTime
  offsetSeconds   Int?
  sourceId        String?
  createdAt       DateTime @default(now())
  meeting         Meeting  @relation(fields: [meetingId], references: [id], map: "MeetingTranscript_meetingId_fkey")

  @@index([meetingId, captionTime], map: "MeetingTranscript_meetingId_captionTime_idx")
  @@map("MeetingTranscript")
}

model MeetLiveDocActivity {
  id                Int                @id @default(autoincrement())
  meetingId         Int
  participantId     Int
  meetingActivityId Int?
  actionType        String
  documentName      String?
  documentUrl       String?
  pageNumber        Int?
  totalPages        Int?
  timestamp         DateTime
  durationSeconds   Int?
  metadata          String?
  createdAt         DateTime           @default(now())
  meetingActivity   MeetingActivity?   @relation(fields: [meetingActivityId], references: [id], map: "MeetLiveDocActivity_meetingActivityId_fkey")
  participant       MeetingParticipant @relation(fields: [participantId], references: [id], map: "MeetLiveDocActivity_participantId_fkey")

  @@index([meetingActivityId], map: "MeetLiveDocActivity_meetingActivityId_fkey")
  @@index([participantId], map: "MeetLiveDocActivity_participantId_fkey")
  @@map("MeetLiveDocActivity")
}

model MeetUser {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique(map: "MeetUser_email_key")
  phone                   String?
  displayName             String?
  note                    String?
  createdAt               DateTime                 @default(now())
  createdBy               String?
  modifiedAt              DateTime?
  modifiedBy              String?
  participants            MeetingParticipant[]
  recordingAccessRequests RecordingAccessRequest[]

  @@map("MeetUser")
}

model Recording {
  id                 Int                      @id @default(autoincrement())
  shareKey           String?                  @unique(map: "Recording_shareKey_key")
  visibility         String                   @default("PRIVATE")
  meetingId          Int
  teamMemberId       Int
  fileName           String
  storageProvider    String                   @default("LOCAL")
  storageKey         String
  storageUrl         String?
  fileSizeBytes      Int?
  durationSeconds    Int?
  mimeType           String?
  status             String                   @default("UPLOADING")
  mediaStartedAt     DateTime?
  activityToken      String?                  @unique(map: "Recording_activityToken_key")
  sttTaskId          String?
  sttStatus          String?
  sttStartedAt       DateTime?
  sttError           String?                  @db.Text
  /// Layout recorded: follow | gallery | speaker | audio
  mode               String                   @default("follow")
  /// Set while the recording is paused (pause = the recorder shows a "paused" slate and is silent)
  pausedAt           DateTime?
  /// Closed pauses as [{ "from": ISO, "to": ISO }] — skipped on replay and not billed
  pauseSpans         Json?
  /// Transcribe automatically once the file is ready (copied from the meeting at start)
  syncTranscript     Boolean                  @default(true)
  /// screen_share (the web egress video, as before) | livedoc_full (Kloud saves the LiveDoc actions)
  kind               String                   @default("screen_share")
  /// Kloud recording id (MeetingServer recording/start_recording) for livedoc_full
  livedocRecordingId Int?
  /// When Kloud started saving actions: time zero of the LiveDoc timeline
  livedocStartedAt   DateTime?
  /// Kloud user token that started it, kept only until Kloud's recording is ended (room may empty first)
  livedocToken       String?                  @db.Text
  createdAt          DateTime                 @default(now())
  createdBy          String?
  deletedAt          DateTime?
  deletedBy          String?
  meeting            Meeting                  @relation(fields: [meetingId], references: [id], map: "Recording_meetingId_fkey")
  teamMember         TeamMember               @relation(fields: [teamMemberId], references: [id], map: "Recording_teamMemberId_fkey")
  accessRequests     RecordingAccessRequest[]
  speakIntervals     RecordingSpeakInterval[]
  sections           RecordingSection[]

  @@index([meetingId], map: "Recording_meetingId_fkey")
  @@index([teamMemberId], map: "Recording_teamMemberId_fkey")
  @@map("Recording")
}

/// One media file of a livedoc_full recording (voice, a screen share), placed on the LiveDoc timeline.
model RecordingSection {
  id          Int       @id @default(autoincrement())
  recordingId Int
  /// voice | screen | (later) camera
  kind        String
  /// File in the recording bucket; the egress id until the file is ready
  storageKey  String
  status      String    @default("PROCESSING")
  /// Milliseconds from Recording.livedocStartedAt
  startMs     Int?
  endMs       Int?
  /// Sharer / speaker (LiveKit identity), when known
  userId      String?
  /// Provider handle (LiveKit egress id)
  providerRef String
  createdAt   DateTime  @default(now())
  recording   Recording @relation(fields: [recordingId], references: [id], map: "RecordingSection_recordingId_fkey")

  @@index([recordingId], map: "RecordingSection_recordingId_fkey")
  @@index([providerRef], map: "RecordingSection_providerRef_idx")
  @@map("RecordingSection")
}

model RecordingSpeakInterval {
  id                  Int       @id @default(autoincrement())
  recordingId         Int
  participantIdentity String
  displayName         String
  startedAt           DateTime
  endedAt             DateTime
  avgLevel            Float
  peakLevel           Float
  createdAt           DateTime  @default(now())
  recording           Recording @relation(fields: [recordingId], references: [id], map: "RecordingSpeakInterval_recordingId_fkey")

  @@index([recordingId, startedAt], map: "RecordingSpeakInterval_recordingId_startedAt_idx")
  @@map("RecordingSpeakInterval")
}

model RecordingAccessRequest {
  id                  Int       @id @default(autoincrement())
  recordingId         Int
  meetUserId          Int
  meetingId           Int
  status              String    @default("PENDING")
  accessToken         String    @unique(map: "RecordingAccessRequest_accessToken_key")
  expiresAt           DateTime?
  requestedAt         DateTime  @default(now())
  respondedAt         DateTime?
  respondedByMemberId Int?
  meetUser            MeetUser  @relation(fields: [meetUserId], references: [id], map: "RecordingAccessRequest_meetUserId_fkey")
  meeting             Meeting   @relation(fields: [meetingId], references: [id], map: "RecordingAccessRequest_meetingId_fkey")
  recording           Recording @relation(fields: [recordingId], references: [id], map: "RecordingAccessRequest_recordingId_fkey")

  @@index([meetUserId], map: "RecordingAccessRequest_meetUserId_fkey")
  @@index([meetingId], map: "RecordingAccessRequest_meetingId_fkey")
  @@index([recordingId], map: "RecordingAccessRequest_recordingId_fkey")
  @@map("RecordingAccessRequest")
}

model Session {
  id           Int        @id @default(autoincrement())
  teamMemberId Int
  token        String     @unique(map: "Session_token_key")
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?    @db.Text
  createdAt    DateTime   @default(now())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], map: "Session_teamMemberId_fkey")

  @@index([teamMemberId], map: "Session_teamMemberId_fkey")
  @@map("Session")
}

model SystemSetting {
  id         Int       @id @default(autoincrement())
  key        String    @unique(map: "SystemSetting_key_key")
  value      String    @db.Text
  createdAt  DateTime  @default(now())
  modifiedAt DateTime?

  @@map("SystemSetting")
}

model TeamMember {
  id                  Int                    @id @default(autoincrement())
  email               String?                @unique(map: "TeamMember_email_key")
  googleId            String?                @unique(map: "TeamMember_googleId_key")
  username            String                 @unique(map: "TeamMember_username_key")
  phone               String?
  passwordHash        String
  fullName            String?
  firstName           String?
  middleName          String?
  lastName            String?
  biography           String?
  personalRoomId      String?                @unique(map: "TeamMember_personalRoomId_key")
  /// Secret for the private calendar subscription feed; null = feed disabled (prisma/add_calendar_feed.sql)
  calendarFeedToken   String?                @unique(map: "TeamMember_calendarFeedToken_key") @db.VarChar(64)
  /// Access level for this person's new meetings (My Profile → Meeting settings); null = Public (prisma/add_member_default_meeting_access.sql)
  defaultMeetingAccess String?               @db.VarChar(16)
  /// Design links (Figma) in this person's meetings (My Profile → Meeting settings); off by default (prisma/add_member_design_links.sql)
  designLinksEnabled  Boolean                @default(false)
  avatarUrl           String?
  /// Kloud (kloud.cn) user ID connected as a sign-in method; null = not connected (prisma/add_account_linking.sql)
  kloudUserId         String?                @unique(map: "TeamMember_kloudUserId_key") @db.VarChar(32)
  kloudLinkedAt       DateTime?
  /// Kloud companies and roles seen at the last Kloud sign-in: [{ id, name, role }]
  kloudCompanies      Json?
  kloudCompaniesAt    DateTime?
  emailVerified       Boolean                @default(false)
  emailVerifiedAt     DateTime?
  phoneVerified       Boolean                @default(false)
  phoneVerifiedAt     DateTime?
  status              String                 @default("ACTIVE")
  createdAt           DateTime               @default(now())
  createdBy           String?
  modifiedAt          DateTime?
  modifiedBy          String?
  deletedAt           DateTime?
  deletedBy           String?
  memberships         AccountMembership[]
  ownerRoles          AccountOwnerAndAdmin[]
  meetings            Meeting[]
  meetingParticipants MeetingParticipant[]
  recordings          Recording[]
  sessions            Session[]

  @@map("TeamMember")
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  target    String
  code      String
  type      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([target, code], map: "VerificationCode_target_code_idx")
  @@index([target, type, createdAt], map: "VerificationCode_target_type_createdAt_idx")
  @@map("VerificationCode")
}

/// 计费：每个账户一行。缺省（无行）= FREE；BILLING_ENABLED 关闭时一律按 LEGACY。
model BillingSubscription {
  id                   Int              @id @default(autoincrement())
  accountId            Int              @unique(map: "BillingSubscription_accountId_key")
  /// FREE / PRO / TEAM / ENTERPRISE / LEGACY
  plan                 String           @default("FREE")
  /// Stripe 订阅状态：active / trialing / past_due / canceled / incomplete / unpaid …
  status               String           @default("active")
  /// month / year
  interval             String?
  seats                Int              @default(1)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  stripeCustomerId     String?          @unique(map: "BillingSubscription_stripeCustomerId_key")
  stripeSubscriptionId String?          @unique(map: "BillingSubscription_stripeSubscriptionId_key")
  /// STRIPE / MANUAL（企业、老客户后台手工开通）
  source               String           @default("STRIPE")
  /// 最近一次已应用的 Stripe 事件时间，丢弃乱序到达的旧事件
  lastStripeEventAt    DateTime?
  createdAt            DateTime         @default(now())
  modifiedAt           DateTime?
  account              KloudMeetAccount @relation(fields: [accountId], references: [id], map: "BillingSubscription_accountId_fkey")

  @@map("BillingSubscription")
}

/// Team 席位：Owner 自动占第一个席位，管理员分配其余席位。
model BillingSeat {
  id                 Int              @id @default(autoincrement())
  accountId          Int
  teamMemberId       Int
  assignedAt         DateTime         @default(now())
  assignedByMemberId Int?
  createdAt          DateTime         @default(now())
  account            KloudMeetAccount @relation(fields: [accountId], references: [id], map: "BillingSeat_accountId_fkey")

  @@unique([accountId, teamMemberId], map: "BillingSeat_accountId_teamMemberId_key")
  @@index([teamMemberId], map: "BillingSeat_teamMemberId_idx")
  @@map("BillingSeat")
}

/// 计量流水。sourceRef 唯一，重复回调不会重复计量。
model UsageEvent {
  id           Int      @id @default(autoincrement())
  /// 无账户的个人免费用户为 NULL，按 teamMemberId 归集
  accountId    Int?
  teamMemberId Int?
  meetingId    Int?
  /// RECORDING / CAPTIONS（秒）· AI_SUMMARY（次）
  kind         String
  quantity     Int
  occurredAt   DateTime
  sourceRef    String   @unique(map: "UsageEvent_sourceRef_key")
  createdAt    DateTime @default(now())

  @@index([accountId, kind, occurredAt], map: "UsageEvent_accountId_kind_occurredAt_idx")
  @@index([teamMemberId, kind, occurredAt], map: "UsageEvent_teamMemberId_kind_occurredAt_idx")
  @@map("UsageEvent")
}

/// 小时包。套餐额度用完后才开始消耗，先到期的先用。
model BillingCredit {
  id              Int              @id @default(autoincrement())
  accountId       Int
  seconds         Int
  consumedSeconds Int              @default(0)
  purchasedAt     DateTime         @default(now())
  expiresAt       DateTime
  stripeRef       String           @unique(map: "BillingCredit_stripeRef_key")
  createdAt       DateTime         @default(now())
  account         KloudMeetAccount @relation(fields: [accountId], references: [id], map: "BillingCredit_accountId_fkey")

  @@index([accountId, expiresAt], map: "BillingCredit_accountId_expiresAt_idx")
  @@map("BillingCredit")
}

/// One-time hand-off from a browser Google sign-in to the desktop app (PKCE: the app holds the verifier).
model DesktopAuthHandoff {
  id           Int       @id @default(autoincrement())
  codeHash     String    @unique(map: "DesktopAuthHandoff_codeHash_key") @db.VarChar(64)
  teamMemberId Int
  challenge    String    @db.VarChar(64)
  next         String?   @db.VarChar(512)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt], map: "DesktopAuthHandoff_expiresAt_idx")
  @@map("DesktopAuthHandoff")
}

/// One-time intents to connect a sign-in method (Google / Kloud) to the signed-in account.
/// Tokens are stored as SHA-256 hashes, live 10 minutes and work once (prisma/add_account_linking.sql).
model AccountLinkIntent {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @unique(map: "AccountLinkIntent_tokenHash_key") @db.VarChar(64)
  teamMemberId Int
  provider     String    @db.VarChar(16)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt], map: "AccountLinkIntent_expiresAt_idx")
  @@map("AccountLinkIntent")
}

/// People invited by email from the schedule dialog
model MeetingInvitee {
  id         Int       @id @default(autoincrement())
  meetingId  Int
  email      String
  /// When the latest invitation was sent, and for which start time (a new time re-sends it)
  invitedAt  DateTime?
  invitedFor DateTime?
  /// This attendee's own join link (/rooms/<room>?invite=<joinToken>)
  joinToken  String?   @unique(map: "MeetingInvitee_joinToken_key") @db.VarChar(64)
  createdAt  DateTime  @default(now())
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, email])
  @@index([meetingId])
  @@map("MeetingInvitee")
}

/// Someone outside the invite list asking to join a Protected meeting; the host or a co-host answers.
model MeetingJoinRequest {
  id                  Int       @id @default(autoincrement())
  meetingId           Int
  teamMemberId        Int
  displayName         String
  /// PENDING | ADMITTED | DENIED | CANCELED
  status              String    @default("PENDING") @db.VarChar(16)
  requestedAt         DateTime  @default(now())
  /// The waiting page polls; requests not seen for a while are no longer shown to the host
  lastSeenAt          DateTime  @default(now())
  respondedAt         DateTime?
  respondedByMemberId Int?
  meeting             Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade, map: "MeetingJoinRequest_meetingId_fkey")

  @@unique([meetingId, teamMemberId], map: "MeetingJoinRequest_meetingId_teamMemberId_key")
  @@index([meetingId, status], map: "MeetingJoinRequest_meetingId_status_idx")
  @@map("MeetingJoinRequest")
}

/// One row per reminder sent, so each reminder goes out once per start time
model MeetingReminderLog {
  id            Int      @id @default(autoincrement())
  meetingId     Int
  offsetMinutes Int
  scheduledFor  DateTime
  sentAt        DateTime @default(now())
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, offsetMinutes, scheduledFor])
  @@index([meetingId])
  @@map("MeetingReminderLog")
}
